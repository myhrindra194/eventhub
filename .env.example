SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EVENT_BUCKET=eventhub-images

# Variables équivalentes acceptées en --dart-define (CI / prod, sans fichier .env) :
#   flutter build web --dart-define=SUPABASE_URL=... \
#     --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=SUPABASE_EVENT_BUCKET=eventhub-images