# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/settings.json
pubspec_overrides.yaml

# Generated code (*.g.dart, *.freezed.dart) is committed on purpose: CI and
# reviewers see exactly what the generators produced.

# Firebase (local config). lib/firebase_options.dart is versioned on purpose:
# it only holds the client identifiers already embedded in every build of the
# app (see docs/SECURITY.md, "Secrets"). The native files below are
# regenerated by `flutterfire configure` and are not needed by the build.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.firebase/
*.env
.env.*

# Firebase emulators: data exported by `make emulators` and debug logs.
.emulator-data/
*-debug.log

# OS
.DS_Store
Thumbs.db

# Android
android/.gradle/
android/local.properties
android/key.properties
**/*.keystore
**/*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
**/Flutter/ephemeral/

# Coverage
coverage/

# Local documents (the product spec is versioned for the team)
*.pdf
!EVENTHUB*Cahier des charges MVP.pdf
*.jpeg
*.jpg
!assets/**

# Local credential files (service accounts, keystores passwords…): never
# committed, the repository is public.
secrets/

# Build-time dart-defines per flavor. env/dev.json and env/example.json are
# versioned: they only hold public client values (emulator switch, OAuth web
# client id, Web Push public key). Never put a secret in env/*.json.
env/*.json
!env/example.json
!env/dev.json

# Claude Code local worktrees
.claude/worktrees/

# Artefacts locaux de l'outil de design (hors projet Flutter)
/uploads/
/screenshots/
/.thumbnail
/support.js

# Node tooling (Firestore rules tests)
node_modules/
# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.env
