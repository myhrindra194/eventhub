<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase Auth, Cloud Firestore and FCM. The debug manifest adds it
         implicitly; a release build without it never reaches the backend. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+: push notifications are opt-in, asked after sign-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Appareil photo : photo de profil ou de couverture, et scan des billets
         à l'entrée. mobile_scanner l'apporte déjà par fusion de manifeste, mais
         le profil en dépend désormais aussi : on le déclare ici pour ne pas
         perdre la permission le jour où le scanner serait retiré ou remplacé.
         Déclarée seule, la permission rendrait la caméra obligatoire aux yeux
         du Play Store et masquerait l'app sur les appareils sans caméra
         (tablettes, Chromebooks) : d'où `required="false"`. -->
    <!-- Accès aux photos pour importer une photo de profil ou de couverture :
         READ_MEDIA_IMAGES à partir d'Android 13, stockage externe en dessous. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="EventHub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links: https://eventhub-d411f.web.app/e/{id} opens the
                 event in the app (route /e/:eventId). Verified against
                 hosting/public/.well-known/assetlinks.json — add the release
                 signing fingerprint there before publishing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="eventhub-d411f.web.app"/>
                <data android:host="eventhub-d411f.firebaseapp.com"/>
                <data android:pathPrefix="/e/"/>
                <!-- Return from Stripe Checkout (F-11). Paid tickets stay
                     disabled until a server exists (Blaze plan); the path is
                     kept so already-verified links keep opening the app. -->
                <data android:pathPrefix="/pay/"/>
            </intent-filter>
        </activity>

        <!-- Default channel: local notifications (day-before reminders
             scheduled on the device) and FCM messages a future server sender
             would target. Created by the app at startup
             (LocalNotificationDataSource). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="eventhub_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Analytics collects nothing until the user consents
             (AnalyticsConsent → setAnalyticsCollectionEnabled). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
