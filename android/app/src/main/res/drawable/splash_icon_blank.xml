<?xml version="1.0" encoding="utf-8"?>
<!-- Icône vide pour l'écran de démarrage d'Android 12+ : le système impose
     une icône au centre ; transparente, elle laisse un aplat de couleur qui
     se fond dans le splash Flutter au lieu d'y superposer l'icône du lanceur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="108dp" android:height="108dp" />
</shape>
