{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "eventhub-d411f",
          "appId": "1:930281380072:android:cb45cb9366f6617e79115d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "eventhub-d411f",
          "configurations": {
            "android": "1:930281380072:android:cb45cb9366f6617e79115d",
            "ios": "1:930281380072:ios:6f111a2562693a8179115d",
            "macos": "1:930281380072:ios:6f111a2562693a8179115d",
            "web": "1:930281380072:web:25189f1d00440ad479115d",
            "windows": "1:930281380072:web:b83b0e6adc87e6dc79115d"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting/public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/e/**",
        "destination": "/e.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
