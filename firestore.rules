rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function userRole() {
      return exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ) ? get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role : '';
    }

    function isParticipant() {
      return isAuthenticated()
        && userRole() == 'participant';
    }

    function isOrganizer() {
      return isAuthenticated()
        && userRole() == 'organizer';
    }


    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {

      // Un utilisateur peut créer son propre profil.
      // Le rôle est validé : participant ou organizer uniquement.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
        && request.resource.data.role in ['participant', 'organizer'];

      // Un utilisateur peut consulter et modifier
      // uniquement son propre profil.
      allow read, update: if isOwner(userId);

      // Suppression d'un profil interdite dans le MVP.
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // EVENTS
    // ─────────────────────────────────────────────

    match /events/{eventId} {

      // Un participant ne voit que les événements publiés.
      // Un organizer ne voit que ses propres événements.
      allow read: if (
          isParticipant()
          && resource.data.status == 'live'
        ) || (
          isOrganizer()
          && resource.data.organizerId == request.auth.uid
        );

      // Seul un organisateur peut créer un événement.
      // organizerId doit correspondre à son UID.
      allow create: if isOrganizer()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status in ['draft', 'live', 'completed', 'cancelled']
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0;

      // Un organisateur peut modifier uniquement
      // ses propres événements.
      // organizerId ne peut pas être changé.
      //
      // Un participant ne peut qu'incrémenter currentAttendees, sur un
      // événement publié, sans dépasser la capacité : c'est ce que fait la
      // transaction de réservation. Toute autre écriture est refusée.
      allow update: if (
          isOrganizer()
          && resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId
              == resource.data.organizerId
        ) || (
          isParticipant()
          && resource.data.status == 'live'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentAttendees', 'updatedAt'])
          && request.resource.data.currentAttendees is int
          && request.resource.data.currentAttendees
              > resource.data.currentAttendees
          && request.resource.data.currentAttendees <= resource.data.capacity
        );

      // Un organisateur peut supprimer uniquement
      // ses propres événements.
      allow delete: if isOrganizer()
        && resource.data.organizerId == request.auth.uid;
    }


    // ─────────────────────────────────────────────
    // RESERVATIONS
    // ─────────────────────────────────────────────

    match /reservations/{reservationId} {

      // Un participant peut créer une réservation
      // uniquement pour lui-même.
      //
      // L'événement doit exister.
      // Le statut initial doit être "confirmed".
      allow create: if isParticipant()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && exists(
          /databases/$(database)/documents/events/$(request.resource.data.eventId)
        )
        && request.resource.data.status == 'confirmed'
        && request.resource.data.reservedAt != null;

      // Lecture :
      //
      // Participant :
      // uniquement ses propres réservations.
      //
      // Organisateur :
      // uniquement les réservations liées
      // à ses propres événements.
      // On vérifie que l'événement existe pour éviter un get() sur un doc absent.
      allow read: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          ||
          (
            isOrganizer()
            && resource.data.eventId is string
            && exists(
              /databases/$(database)/documents/events/$(resource.data.eventId)
            )
            && get(
              /databases/$(database)/documents/events/$(resource.data.eventId)
            ).data.organizerId == request.auth.uid
          )
        );

      // Les réservations ne sont pas modifiables
      // ou supprimables directement par les utilisateurs.
      allow update, delete: if false;
    }
  }
}