# =============================================================================
#  SMTP des emails d'authentification (fichier local, ignoré par Git)
# =============================================================================
#  Recommandé : Brevo (gratuit, 300 emails/jour, aucun nom de domaine requis).
#   1. Créer un compte sur https://www.brevo.com
#   2. Senders, domains & dedicated IPs → Senders → Add a sender :
#      ton adresse (ex. Elvithondev@gmail.com), puis cliquer le lien reçu.
#   3. SMTP & API → onglet SMTP → Generate a new SMTP key.
#   4. Remplir les 4 lignes ci-dessous (sans guillemets), enregistrer,
#      puis dire « smtp prêt ».
#
#  Alternative Gmail : SMTP_HOST=smtp.gmail.com, SMTP_USER=ton adresse Gmail,
#  SMTP_PASS=un « mot de passe d'application » (Compte Google → Sécurité →
#  Validation en deux étapes → Mots de passe des applications), 500 emails/jour.
# =============================================================================

SMTP_HOST=smtp-relay.brevo.com
# Brevo : l'identifiant affiché dans l'onglet SMTP (souvent xxxxx@smtp-brevo.com)
SMTP_USER=
# Brevo : la clé SMTP générée · Gmail : le mot de passe d'application
SMTP_PASS=
# L'adresse expéditrice vérifiée (celle que verront les utilisateurs)
SMTP_SENDER=
