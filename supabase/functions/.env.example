# Secrets of the EventHub Edge Functions.
# Production:  npx supabase secrets set --env-file supabase/functions/.env
# Local serve: npx supabase functions serve --env-file supabase/functions/.env
# Copy to supabase/functions/.env (git-ignored) and fill in.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the runtime.

# Stripe (F-11) — TODO: à renseigner plus tard.
#   STRIPE_SECRET_KEY     : Stripe → Developers → API keys (sk_test_… d'abord, sk_live_… en production)
#   STRIPE_WEBHOOK_SECRET : Stripe → Developers → Webhooks → endpoint
#                           https://<project-ref>.supabase.co/functions/v1/stripe-webhook
#                           (checkout.session.completed, .async_payment_succeeded, .expired,
#                           .async_payment_failed) → « Signing secret » (whsec_…)
#   Absentes : tout fonctionne sauf l'achat d'un billet payant.
#   Attention : `secrets set --env-file` écrase chaque clé présente — ne laissez
#   jamais une ligne vide pour un secret déjà configuré (WORKER_SECRET).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Shared with the database (Vault secret `eventhub_worker_secret`).
# Generate: openssl rand -hex 32
WORKER_SECRET=

# Firebase service account JSON, one line, role "Firebase Cloud Messaging API Admin".
FCM_SERVICE_ACCOUNT=

# Origin of the public site (Checkout return pages, shared links).
PUBLIC_ORIGIN=https://eventhub-d411f.web.app
